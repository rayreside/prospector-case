# ---------------------------------------------------------------- OpenSCAD
# Rendered output - regenerate with:
#   openscad -o out.stl -D 'part="top"' scad/urchin.scad
scad/**/*.stl
scad/**/*.3mf
scad/**/*.off
scad/**/*.amf
scad/out/
scad/build/
render/

# OpenSCAD editor state and caches
*.scad.bak
.openscad/
cache/

# Dependency files from use<>/include<> tracking
*.deps

# ------------------------------------------------------------------ Blender
*.blend
*.blend[0-9]*
*.blend[0-9]*[0-9]
*.blend@

# ------------------------------------------------------------------ FreeCAD
*.FCStd1
*.FCBak
*.FCStd.lock

# ------------------------------------------------------------------- slicer
# Slicer projects and toolpaths - not source
*.gcode
*.gcode.3mf
*.bgcode
*.sl1
*.ctb
*.gco
